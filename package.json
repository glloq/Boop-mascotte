{
  "name": "svg-mascot-rig-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js",
    "test": "node --test project/editor/core/tests/*.test.js",
    "check:conflicts": "node scripts/check-conflicts.mjs",
    "test:e2e": "playwright test",
    "verify:e2e": "playwright test --project=chromium",
    "verify": "npm run check:conflicts && npm test && npm run build"
  },
  "dependencies": {
    "svg.draggable.js": "^2.2.2",
    "svg.resize.js": "^1.4.3",
    "svg.select.js": "^3.0.1",
    "svg.js": "^2.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^6.3.5"
  }
}
