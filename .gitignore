# Snapshots from `scripts/face-snapshots.mjs`: a review aid, never a fixture.
out/

# Scratch worktrees for parallel agents: checkouts of this same repo, cleaned
# up when the agent finishes. `.claude/` itself is not ignored -- settings and
# skills kept there belong to the project.
.claude/worktrees/

# A local Playwright config, for a machine whose installed Chromium build is not
# the one `@playwright/test` pins: it copies playwright.config.js and adds
# `launchOptions.executablePath`. Machine-specific by nature, so it stays here.
pw-local.config.js
