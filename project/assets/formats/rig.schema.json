{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glloq.github.io/Boop-mascotte/rig.schema.json",
  "title": "Boop Mascotte Rig v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "params",
    "states",
    "elements"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "activeState": {
      "type": "string"
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        }
      }
    },
    "elements": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/element"
      }
    },
    "globalConstraints": {
      "$ref": "#/$defs/constraintScale"
    },
    "stateConstraints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/constraintScale"
      }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "runtimeConfig": {
      "type": "object",
      "properties": {
        "blink": {
          "type": "boolean"
        },
        "idleMotion": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "transitionSettings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "duration",
          "easing"
        ],
        "properties": {
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "easing": {
            "enum": [
              "linear",
              "easeIn",
              "easeOut",
              "easeInOut"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behavior"
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": [
        "type",
        "min",
        "max",
        "default",
        "value"
      ],
      "properties": {
        "type": {
          "const": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "default": {
          "type": "number"
        },
        "value": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "required": [
        "x",
        "y",
        "rotation",
        "scaleX",
        "scaleY"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "scaleX": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "scaleY": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "pivotX": {
          "type": "number"
        },
        "pivotY": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "enabled",
        "expression",
        "curve",
        "amplitude",
        "offset"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "expression": {
          "type": "string"
        },
        "curve": {
          "enum": [
            "linear",
            "easeIn",
            "easeOut",
            "easeInOut"
          ]
        },
        "amplitude": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "constraintScale": {
      "type": "object",
      "properties": {
        "translate": {
          "type": "number"
        },
        "rotate": {
          "type": "number"
        },
        "scale": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": [
        "baseTransform",
        "bindings",
        "constraints"
      ],
      "properties": {
        "baseTransform": {
          "$ref": "#/$defs/transform"
        },
        "baseOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "translateX",
              "translateY",
              "rotation",
              "scaleX",
              "scaleY",
              "opacity",
              "morph"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "translate": {
              "type": "boolean"
            },
            "rotate": {
              "type": "boolean"
            },
            "scale": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "symmetryPeer": {
          "type": [
            "string",
            "null"
          ]
        },
        "morph": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "param": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "pathA": {
              "type": "string"
            },
            "pathB": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "behavior": {
      "type": "object",
      "required": [
        "type",
        "enabled",
        "parameter"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "blink",
            "oscillator",
            "randomIdle"
          ]
        },
        "name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "parameter": {
          "type": "string"
        },
        "intervalMin": {
          "type": "number",
          "minimum": 0
        },
        "intervalMax": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "closedValue": {
          "type": "number"
        },
        "amplitude": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "frequency": {
          "type": "number",
          "minimum": 0
        },
        "waveform": {
          "const": "sine"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "additionalProperties": true
    }
  }
}
