{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glloq.github.io/Boop-mascotte/rig.schema.json",
  "title": "Boop Mascotte Rig v4",
  "type": "object",
  "required": [
    "schemaVersion",
    "params",
    "states",
    "elements"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "activeState": {
      "type": "string"
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        }
      }
    },
    "elements": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/element"
      }
    },
    "globalConstraints": {
      "$ref": "#/$defs/constraintScale"
    },
    "stateConstraints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/constraintScale"
      }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "runtimeConfig": {
      "type": "object",
      "properties": {
        "blink": {
          "type": "boolean"
        },
        "idleMotion": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "transitionSettings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "duration",
          "easing"
        ],
        "properties": {
          "duration": {
            "type": "number",
            "minimum": 1
          },
          "easing": {
            "enum": [
              "linear",
              "easeIn",
              "easeOut",
              "easeInOut"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behavior"
      }
    },
    "keyforms": {
      "description": "Pose grids: parameter axes plus captured channel values (docs/KEYFORM_ENGINE.md).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/keyform"
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": [
        "type",
        "min",
        "max",
        "default",
        "value"
      ],
      "properties": {
        "type": {
          "const": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "default": {
          "type": "number"
        },
        "value": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "required": [
        "x",
        "y",
        "rotation",
        "scaleX",
        "scaleY"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "scaleX": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "scaleY": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "pivotX": {
          "type": "number"
        },
        "pivotY": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "enabled",
        "expression",
        "curve",
        "amplitude",
        "offset"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "simple",
            "advanced"
          ]
        },
        "expression": {
          "type": "string"
        },
        "curve": {
          "enum": [
            "linear",
            "easeIn",
            "easeOut",
            "easeInOut"
          ]
        },
        "amplitude": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "constraintScale": {
      "type": "object",
      "properties": {
        "translate": {
          "type": "number"
        },
        "rotate": {
          "type": "number"
        },
        "scale": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": [
        "baseTransform",
        "bindings",
        "constraints"
      ],
      "properties": {
        "baseTransform": {
          "$ref": "#/$defs/transform"
        },
        "baseOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "translateX",
              "translateY",
              "rotation",
              "scaleX",
              "scaleY",
              "opacity"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "translate": {
              "type": "boolean"
            },
            "rotate": {
              "type": "boolean"
            },
            "scale": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "symmetryPeer": {
          "type": [
            "string",
            "null"
          ]
        },
        "morph": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "param": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "pathA": {
              "type": "string"
            },
            "pathB": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "behavior": {
      "type": "object",
      "required": [
        "type",
        "enabled",
        "parameter"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "blink",
            "oscillator",
            "randomIdle"
          ]
        },
        "name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "parameter": {
          "type": "string"
        },
        "intervalMin": {
          "type": "number",
          "minimum": 0
        },
        "intervalMax": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "closedValue": {
          "type": "number"
        },
        "amplitude": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "frequency": {
          "type": "number",
          "minimum": 0
        },
        "waveform": {
          "const": "sine"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "keyformAxis": {
      "type": "object",
      "required": [
        "parameter",
        "values"
      ],
      "properties": {
        "parameter": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "keyform": {
      "type": "object",
      "required": [
        "id",
        "target",
        "channel",
        "axes",
        "keyforms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "element"
            },
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "channel": {
          "enum": [
            "translateX",
            "translateY",
            "rotation",
            "scaleX",
            "scaleY",
            "opacity",
            "pathShape"
          ]
        },
        "shapeKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/keyformAxis"
          }
        },
        "keyforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "value"
            ],
            "properties": {
              "at": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "value": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "extrapolation": {
          "enum": [
            "clamp",
            "linear"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
