{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glloq.github.io/Boop-mascotte/rig.schema.json",
  "title": "Boop Mascotte Rig v4",
  "type": "object",
  "required": [
    "schemaVersion",
    "params",
    "states",
    "elements"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "activeState": {
      "type": "string"
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        }
      }
    },
    "elements": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/element"
      }
    },
    "globalConstraints": {
      "$ref": "#/$defs/constraintScale"
    },
    "stateConstraints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/constraintScale"
      }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "runtimeConfig": {
      "type": "object",
      "properties": {
        "blink": {
          "type": "boolean"
        },
        "idleMotion": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "transitionSettings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "duration",
          "easing"
        ],
        "properties": {
          "duration": {
            "type": "number",
            "minimum": 1
          },
          "easing": {
            "enum": [
              "linear",
              "easeIn",
              "easeOut",
              "easeInOut"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behavior"
      }
    },
    "keyforms": {
      "description": "Pose grids: parameter axes plus captured channel values (docs/KEYFORM_ENGINE.md).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/keyform"
      }
    },
    "shapeKeys": {
      "description": "Additive path deltas over an element restPath (docs/SHAPE_KEYS.md).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/shapeKey"
      }
    },
    "hands": {
      "description": "Two floating hands: anchors, reach, poses and inertia (docs/HAND_RIGGING.md).",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "left": {
          "$ref": "#/$defs/hand"
        },
        "right": {
          "$ref": "#/$defs/hand"
        }
      },
      "additionalProperties": false
    },
    "deformers": {
      "description": "Light transform hierarchy (docs/DEFORMER_MODEL.md).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/deformer"
      }
    },
    "parallax": {
      "description": "Head-driven depth parallax (docs/DEPTH_PARALLAX.md).",
      "type": [
        "object",
        "null"
      ],
      "$ref": "#/$defs/parallax"
    },
    "expressionBlend": {
      "description": "How long an expression change takes (docs/CONTINUOUS_TRANSITIONS.md).",
      "type": [
        "object",
        "null"
      ]
    },
    "warps": {
      "description": "Small optional control grids (docs/WARP_GRID.md).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/warp"
      }
    },
    "gazeSolver": {
      "description": "Where a gaze target sends the eyes and the head (docs/FACE_CONTROL_RIG.md). Absent means no solver: `lookX`/`lookY` and `headX`/`headY` mean exactly what they always meant.",
      "type": [
        "object",
        "null"
      ],
      "$ref": "#/$defs/gazeSolver"
    },
    "rigPins": {
      "description": "Structural points the artwork is held by (docs/FACE_CONTROL_RIG.md). Absent means the rig deforms by transform, shape key and warp alone.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/rigPin"
      }
    },
    "rigConstraints": {
      "description": "Relationships the rig holds true whatever moved either side (docs/FACE_CONTROL_RIG.md). Solved in list order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/rigConstraint"
      }
    },
    "rigAttachments": {
      "description": "Named points on the artwork, resolved from where it ended up after deformation.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/rigAttachment"
      }
    },
    "rigHolds": {
      "description": "One attachment held on another, with a weight that may be an animated parameter.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/rigHold"
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": [
        "type",
        "min",
        "max",
        "default",
        "value"
      ],
      "properties": {
        "type": {
          "const": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "default": {
          "type": "number"
        },
        "value": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "required": [
        "x",
        "y",
        "rotation",
        "scaleX",
        "scaleY"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "scaleX": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "scaleY": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "pivotX": {
          "type": "number"
        },
        "pivotY": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "enabled",
        "expression",
        "curve",
        "amplitude",
        "offset"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "simple",
            "advanced"
          ]
        },
        "expression": {
          "type": "string"
        },
        "curve": {
          "enum": [
            "linear",
            "easeIn",
            "easeOut",
            "easeInOut"
          ]
        },
        "amplitude": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "constraintScale": {
      "type": "object",
      "properties": {
        "translate": {
          "type": "number"
        },
        "rotate": {
          "type": "number"
        },
        "scale": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": [
        "baseTransform",
        "bindings",
        "constraints"
      ],
      "properties": {
        "baseTransform": {
          "$ref": "#/$defs/transform"
        },
        "baseOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "translateX",
              "translateY",
              "rotation",
              "scaleX",
              "scaleY",
              "opacity"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "translate": {
              "type": "boolean"
            },
            "rotate": {
              "type": "boolean"
            },
            "scale": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "symmetryPeer": {
          "type": [
            "string",
            "null"
          ]
        },
        "morph": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "param": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "pathA": {
              "type": "string"
            },
            "pathB": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "restPath": {
          "type": "string",
          "description": "Neutral shape for additive shape keys."
        },
        "deformer": {
          "type": "string",
          "description": "Group this element belongs to."
        },
        "depth": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Pseudo depth for parallax and draw order."
        }
      },
      "additionalProperties": true
    },
    "behavior": {
      "type": "object",
      "required": [
        "type",
        "enabled",
        "parameter"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "blink",
            "oscillator",
            "randomIdle",
            "drift"
          ]
        },
        "name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "parameter": {
          "type": "string"
        },
        "intervalMin": {
          "type": "number",
          "minimum": 0
        },
        "intervalMax": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "closedValue": {
          "type": "number"
        },
        "amplitude": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "frequency": {
          "type": "number",
          "minimum": 0
        },
        "waveform": {
          "const": "sine"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "travelMin": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "travelMax": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "doubleChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "keyformAxis": {
      "type": "object",
      "required": [
        "parameter",
        "values"
      ],
      "properties": {
        "parameter": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "keyform": {
      "type": "object",
      "required": [
        "id",
        "target",
        "channel",
        "axes",
        "keyforms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "element"
            },
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "channel": {
          "enum": [
            "translateX",
            "translateY",
            "rotation",
            "scaleX",
            "scaleY",
            "opacity",
            "pathShape"
          ]
        },
        "shapeKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/keyformAxis"
          }
        },
        "keyforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "value"
            ],
            "properties": {
              "at": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "value": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "extrapolation": {
          "enum": [
            "clamp",
            "linear"
          ]
        }
      },
      "additionalProperties": false
    },
    "shapeKey": {
      "type": "object",
      "required": [
        "id",
        "target",
        "delta"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "driver": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "range",
                "expression",
                "none"
              ]
            },
            "parameter": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "clamp": {
              "type": "boolean"
            },
            "expression": {
              "type": "string"
            },
            "curve": {
              "enum": [
                "linear",
                "easeIn",
                "easeOut",
                "easeInOut"
              ]
            },
            "amplitude": {
              "type": "number"
            },
            "offset": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "delta": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "hand": {
      "type": "object",
      "required": [
        "side",
        "element",
        "anchor",
        "reach"
      ],
      "properties": {
        "side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "element": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor": {
          "$ref": "#/$defs/point"
        },
        "restOffset": {
          "$ref": "#/$defs/point"
        },
        "reach": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "rotation": {
              "type": "number"
            },
            "scale": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "softness": {
          "type": "number",
          "minimum": 0
        },
        "depth": {
          "type": "number"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "poses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/handPose"
          }
        },
        "inertia": {
          "$ref": "#/$defs/inertia"
        }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "handPose": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "parameter": {
          "type": "string"
        },
        "shapeKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "description": "The numbers a generated pose was drawn from (docs/HAND_REPRESENTATIONS_STUDY.md): per digit curl, bend, angle, length, width; the palm's width. Kept for the pose editor; the runtime plays the keys.",
          "type": "object"
        },
        "profileTable": {
          "description": "The same pose drawn in profile, when it has a drawing of its own there.",
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "inertia": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "stiffness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "damping": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "maxOvershoot": {
          "type": "number",
          "minimum": 0
        },
        "followAmount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "deformer": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "pivot": {
          "$ref": "#/$defs/point"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "scaleX": {
          "type": "number"
        },
        "scaleY": {
          "type": "number"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          }
        }
      },
      "additionalProperties": false
    },
    "parallax": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "amount": {
          "type": "number"
        },
        "parameterX": {
          "type": "string"
        },
        "parameterY": {
          "type": "string"
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "hysteresis": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "warp": {
      "type": "object",
      "required": [
        "id",
        "target",
        "grid"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "grid": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "minimum": 2,
              "maximum": 5
            },
            "rows": {
              "type": "integer",
              "minimum": 2,
              "maximum": 5
            },
            "box": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/point"
              }
            },
            "rest": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/point"
              }
            }
          },
          "additionalProperties": false
        },
        "driver": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "parameter": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "handGesture": {
      "type": "object",
      "required": [
        "side",
        "pose"
      ],
      "properties": {
        "side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "pose": {
          "type": "string"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "gazeSolver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Whether the gaze decomposition runs. False in every project that predates the solver.",
          "type": "boolean"
        },
        "headFollow": {
          "description": "How much of the angle the eyes cannot cover the head takes.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "deadZoneX": {
          "description": "Gaze the head ignores entirely, sideways.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "deadZoneY": {
          "description": "Gaze the head ignores entirely, vertically.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeYawLimit": {
          "description": "Degrees the eyes reach sideways on their own.",
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "eyePitchLimit": {
          "description": "Degrees the eyes reach vertically on their own.",
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "eyeComfortX": {
          "description": "Fraction of the eye's sideways limit reached before the head helps.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeComfortY": {
          "description": "Fraction of the eye's vertical limit reached before the head helps.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "headYawLimit": {
          "description": "Degrees the head turns sideways.",
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "headPitchLimit": {
          "description": "Degrees the head turns vertically.",
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "headLag": {
          "description": "Seconds before the head starts to follow.",
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "headSettle": {
          "description": "Seconds for the head to arrive.",
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "eyelidFollowX": {
          "description": "How much a sideways gaze narrows the eyes.",
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "eyelidFollowY": {
          "description": "How much a vertical gaze opens or closes the eyes.",
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "gazeAnticipation": {
          "description": "How far the eyes lead a target that is still moving. A derivative term: it vanishes the moment the target stops.",
          "type": "number",
          "minimum": 0,
